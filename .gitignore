.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Raw or downloaded datasets never belong in Git.
datasets/raw/
datasets/downloads/
datasets/cache/

# Large run products are indexed by manifests, not committed by default.
experiments/runs/*/checkpoints/
experiments/runs/*/predictions/
experiments/runs/*/stdout.log
experiments/runs/*/stderr.log
experiments/runs/*/*.ckpt
experiments/runs/*/lightning_logs/
artifacts/*.tar.zst
artifacts/*.tar.zst.sha256
artifacts/*.tar.zst.verification.json

# Listening examples derived from noncommercial source audio remain local.
experiments/audio_examples/**/*.wav
demo/listening/audio/
demo/capture/*.wav
demo/resplit/*.wav
demo/capture/dataset/

# Dedicated Git worktrees are managed separately from the main checkout.
experiments/worktrees/

# Product-lane runs (checkpoints, exported models, logs) stay local.
demo/runs/

# JUCE build artefacts of the demo plugin.
build/demo_plugin/
